          "text": [
            "請輸入角度（度）：30\n",
            "你計算的sin值為:0.50\n"
          ]
        }
      ],
      "source": [
        "import math\n",
        "d=float(input(\"請輸入角度（度）：\"))\n",
        "a=d*(math.pi/180)\n",
        "b=math.sin(a)\n",
        "print(f\"你計算的sin值為:{b:.2f}\")"
      ]
    }
  ]
